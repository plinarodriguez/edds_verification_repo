reset
# Units are in mm
#{pipe_r=2.27}          # diameter of pipe
#{case_r=2.57}          # atomizer diameter 0.3mm thickness
#{case_h=7.2}           # atomizer height
#{pipe_h=51.73}        # full edds length

create Cylinder height {case_h} radius {case_r} 
create Cylinder height {pipe_h} radius {pipe_r} 
subtract volume 2 from volume 1 keep 
delete volume 1
merge all
move Volume 3  z -20.244 include_merged 
move Volume 2 3  z 25.865 include_merged #so that the inlet is at z = 0 
imprint volume 3 2
merge all

volume 3 rename "caseFluid"
volume 2 rename "pipeSolid"
surface 7 rename "interfaceWall"
surface 5 rename "inlet"
surface 6 rename "outlet"
surface 8 rename "externalWall"
surface 9 rename "wallInlet"
surface 10 rename "wallOutlet"
surface 11 rename "wallpm"
surface 13 rename "wallin"

#merge surface all
volume 2 size 0.5
volume 3 size 0.5
mesh volume all

block 1 add volume 2
block 1 name "pipeFluid"
block 2 add volume 3
block 2 name "caseSolid"
sideset 1 add surface 5 
sideset 1 name "inlet"
sideset 2 add surface 6 
sideset 2 name "outlet"
sideset 3 add surface 7 
sideset 3 name "interfaceWall"
sideset 4 add surface 8 
sideset 4 name "externalWall"
sideset 5 add surface 9 
sideset 5 name "wallInlet"
sideset 6 add surface 10 
sideset 6 name "wallOutlet"
sideset 7 add surface 11 
sideset 7 name "wallpm"
sideset 8 add surface 13
sideset 8 name "wallin"

create cfd_bc name 'inlet' Velocityinlet on sideset 1  
create cfd_bc name 'outlet' Pressureoutlet on sideset 2  
#create cfd_bc name 'interfaceWall' Wall on sideset 3
create cfd_bc name 'interfaceWall' Interface on sideset 3 
create cfd_bc name 'externalwallSolid' Wall on sideset 4 
create cfd_bc name 'wallInletSolid' Wall on sideset 5 
create cfd_bc name 'wallOutletSolid' Wall on sideset 6 
create cfd_bc name 'wallpm' Wall on sideset 7
create cfd_bc name 'wallin' Wall on sideset 8

group 'inletPipe' add Surface 5 
group 'outletPipe' add Surface 6 
group 'interfacePipeCase' add Surface 7 
group 'wallsCase' add Surface 8 9 10 
group 'wallsPipe' add Surface 11 13

volume all scale 0.001   # scale from mm to meter  

#Coarse Mesh
export fluent "/ascldap/users/prodrig/Desktop/cubit_test/pipeCase.msh"  overwrite  everything 
export fluent "/ascldap/users/prodrig/Desktop/cubit_test/pipeCaseLoFi_Mesh1.msh"  overwrite  everything 

#Medium Mesh
scale mesh volume all multiplier 2 minimum 1 swept_blocks
export fluent "/ascldap/users/prodrig/Desktop/cubit_test/pipeCaseLoFi_Mesh2.msh"  overwrite  everything 

#Medium Fine Mesh
scale mesh volume all multiplier 2 minimum 1 swept_blocks
export fluent "/ascldap/users/prodrig/Desktop/cubit_test/pipeCaseLoFi_Mesh3.msh"  overwrite  everything 

#Fine Mesh
scale mesh volume all multiplier 2 minimum 1 swept_blocks
export fluent "/ascldap/users/prodrig/Desktop/cubit_test/pipeCaseLoFi_Mesh4.msh"  overwrite  everything 

#Finer Mesh
scale mesh volume all multiplier 2 minimum 1 swept_blocks
export fluent "/ascldap/users/prodrig/Desktop/cubit_test/pipeCaseLoFi_Mesh5.msh"  overwrite  everything 

#Finest Mesh
scale mesh volume all multiplier 2 minimum 1 swept_blocks
export fluent "/ascldap/users/prodrig/Desktop/cubit_test/pipeCaseLoFi_Mesh6.msh"  overwrite  everything 

#Most Fine Mesh
scale mesh volume all multiplier 2 minimum 1 swept_blocks
export fluent "/ascldap/users/prodrig/Desktop/cubit_test/pipeCaseLoFi_Mesh7.msh"  overwrite  everything 

