FoamFile
{
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains {{num_processors}};

method         simple;
// method          ptscotch;

simpleCoeffs
{
    n               ({{num_processors}} 1 1);
}

hierarchicalCoeffs
{
    n               (3 2 1);
    order           xyz;
}

manualCoeffs
{
    dataFile        "cellDecomposition";
}


// ************************************************************************* //
