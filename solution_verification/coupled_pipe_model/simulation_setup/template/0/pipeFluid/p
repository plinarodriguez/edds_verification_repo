FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/pipeFluid";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e-5;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    pipeFluid_to_caseSolid
    {
        type            zeroGradient;
    }
    wallin
    {
        type            zeroGradient;
    }
    wallpm
    {
        type            zeroGradient;
    }
}


