FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant/caseSolid";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          eConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
	nMoles          1;
        molWeight       58.693; // Molecular Weight of Nickel
    }
    thermodynamics
    {
        Cp              444; //this is an artificial heat source, Heat Capacity of Nickel =  444;
        Cv		        444; //this is an artificial heat source, Heat Capacity of Nickel =  444;
        Hf              0;
    }
    transport
    {
        kappa           91;    // Thermal Conductivity of Nickel
    }
    equationOfState
    {
	rho                 8900;  // This is an artificial heat source, Density of Nickel = 8900
    }
}
